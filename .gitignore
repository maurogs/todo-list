# Ignore bundler config and vendored gems.
/.bundle
/vendor/bundle

# Ignore all environment files.
/.env*
!/.env*.erb
!/.env.example

# Ignore all logs and temp files.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files and SQLite databases).
/storage/*
!/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Tailwind build output
/app/assets/builds/*
!/app/assets/builds/.keep

# macOS
.DS_Store
