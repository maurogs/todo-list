<%# locals: (task:, color:, sortable: false, show_list: false) %>
<% styles = color_styles(color) %>
<li id="<%= dom_id(task, :item) %>" <%= tag.attributes(data: { sortable_id: task.id }) if sortable %>
    class="group card flex items-start gap-3 p-3.5 transition hover:border-slate-300 dark:hover:border-slate-700 <%= "cursor-grab" if sortable %>">
  <%= button_to toggle_task_path(task), method: :patch, form: { class: "contents", data: { turbo_frame: "_top" } },
        aria: { label: task.completed? ? "Marcar como pendiente" : "Marcar como completada" },
        class: "mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border-2 transition #{task.completed? ? "#{styles[:check]} text-white" : "border-slate-300 dark:border-slate-600 #{styles[:hover]}"}" do %>
    <% if task.completed? %><%= icon :check, classes: "size-3 animate-pop", stroke: 3.5 %><% end %>
  <% end %>

  <%= turbo_frame_tag dom_id(task), class: "min-w-0 flex-1" do %>
    <div class="flex items-start gap-2">
      <div class="min-w-0 flex-1">
        <p class="text-sm leading-6 break-words <%= "text-slate-400 line-through" if task.completed? %>"><%= task.title %></p>

        <% if task.notes.present? %>
          <p class="mt-0.5 text-sm whitespace-pre-line text-slate-500 dark:text-slate-400"><%= task.notes %></p>
        <% end %>

        <% if task.due_on || !task.priority_none? || show_list %>
          <div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs font-medium">
            <% if show_list %>
              <%= link_to list_path(task.list), data: { turbo_frame: "_top" },
                    class: "inline-flex items-center gap-1 rounded-full px-2 py-0.5 #{color_styles(task.list.color)[:soft]}" do %>
                <%= task.list.icon %> <%= task.list.name %>
              <% end %>
            <% end %>
            <% if task.due_on %>
              <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 <%= task.overdue? ? "bg-rose-50 text-rose-700 dark:bg-rose-500/15 dark:text-rose-300" : "bg-slate-100 text-slate-600 dark:bg-white/10 dark:text-slate-300" %>">
                <%= icon :calendar, classes: "size-3.5" %> <%= due_label(task.due_on) %>
              </span>
            <% end %>
            <% unless task.priority_none? %>
              <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 <%= ApplicationHelper::PRIORITY_STYLES[task.priority] %>">
                <%= icon :flag, classes: "size-3.5" %> <%= ApplicationHelper::PRIORITY_LABELS[task.priority] %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="flex shrink-0 gap-0.5 opacity-100 transition [@media(hover:hover)]:opacity-0 group-focus-within:opacity-100 group-hover:opacity-100">
        <%= link_to edit_task_path(task), class: "icon-btn", aria: { label: "Editar tarea" }, title: "Editar" do %>
          <%= icon :pencil, classes: "size-4" %>
        <% end %>
        <%= button_to task_path(task), method: :delete, class: "icon-btn hover:!text-rose-600", aria: { label: "Eliminar tarea" }, title: "Eliminar",
              form: { class: "contents", data: { turbo_frame: "_top" } } do %>
          <%= icon :trash, classes: "size-4" %>
        <% end %>
      </div>
    </div>
  <% end %>
</li>
