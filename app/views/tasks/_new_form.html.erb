<%# locals: (list:) %>
<%= form_with model: [ list, Task.new ], class: "card mt-6 p-2", data: { controller: "task-form" } do |form| %>
  <div class="flex items-center gap-2">
    <%= form.text_field :title, required: true, maxlength: 200, autocomplete: "off",
          placeholder: "Añadir una tarea…", aria: { label: "Título de la tarea" },
          class: "min-w-0 flex-1 rounded-xl border-0 bg-transparent px-3 py-2.5 text-sm placeholder:text-slate-400 focus:outline-none",
          data: { task_form_target: "title" } %>
    <button type="button" class="icon-btn" data-action="task-form#toggleDetails" aria-label="Más opciones" title="Fecha y prioridad">
      <%= icon :calendar %>
    </button>
    <%= button_tag type: :submit, class: "btn-primary !px-3", aria: { label: "Añadir tarea" } do %>
      <%= icon :plus, stroke: 2.5 %>
    <% end %>
  </div>

  <div class="hidden grid-cols-2 gap-3 border-t border-slate-100 px-2 pt-3 pb-2 [&:not(.hidden)]:grid dark:border-slate-800" data-task-form-target="details">
    <div>
      <%= form.label :due_on, "Fecha límite", class: "label" %>
      <%= form.date_field :due_on, class: "input" %>
    </div>
    <div>
      <%= form.label :priority, "Prioridad", class: "label" %>
      <%= form.select :priority, Task.priorities.keys.map { |p| [ ApplicationHelper::PRIORITY_LABELS[p], p ] }, {}, class: "input" %>
    </div>
  </div>
<% end %>
