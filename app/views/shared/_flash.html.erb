<div class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4" id="flash">
  <% { notice: "bg-slate-900 text-white dark:bg-white dark:text-slate-900", alert: "bg-rose-600 text-white" }.each do |type, style| %>
    <% if (message = flash[type]).present? %>
      <div class="pointer-events-auto flex animate-toast-in items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium shadow-lg transition duration-200 <%= style %>"
           role="<%= type == :alert ? "alert" : "status" %>"
           data-controller="flash" data-action="click->flash#dismiss">
        <%= message %>
      </div>
    <% end %>
  <% end %>
</div>
