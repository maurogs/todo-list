<%# locals: (title:, tasks:, tone: "text-slate-500") %>
<% if tasks.any? %>
  <section class="mt-8">
    <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold <%= tone %>">
      <%= title %>
      <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs text-slate-600 dark:bg-white/10 dark:text-slate-300"><%= tasks.size %></span>
    </h2>
    <ul class="space-y-2">
      <% tasks.each do |task| %>
        <%= render "tasks/task", task: task, color: task.list.color, show_list: true %>
      <% end %>
    </ul>
  </section>
<% end %>
