<%# locals: (title:, list:) %>
<dialog data-dialog-target="dialog" data-action="click->dialog#backdropClick"
        class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm dark:bg-slate-900 dark:text-slate-100">
  <div class="p-6">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="text-lg font-bold tracking-tight"><%= title %></h2>
      <button type="button" class="icon-btn" data-action="dialog#close" aria-label="Cerrar"><%= icon :x %></button>
    </div>
    <%= render "lists/form", list: list %>
  </div>
</dialog>
