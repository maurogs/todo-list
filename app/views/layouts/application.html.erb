<!DOCTYPE html>
<html lang="es" class="h-full">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="h-full bg-slate-50 font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100"
        data-controller="sidebar theme dialog">
    <div class="flex h-full">
      <%= render "shared/sidebar" %>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex items-center gap-3 border-b border-slate-200 bg-white/80 px-4 py-3 backdrop-blur lg:hidden dark:border-slate-800 dark:bg-slate-900/80">
          <button type="button" class="icon-btn" data-action="sidebar#open" aria-label="Abrir menú">
            <%= icon :menu %>
          </button>
          <span class="font-bold tracking-tight">Listo</span>
        </header>

        <main class="flex-1 overflow-y-auto">
          <div class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-8 sm:py-12">
            <%= yield %>
          </div>
        </main>
      </div>
    </div>

    <%= render "shared/flash" %>
    <%= render "lists/new_dialog" %>
  </body>
</html>
