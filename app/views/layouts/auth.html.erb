<!DOCTYPE html>
<html lang="es" class="h-full">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-full bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100"
        data-controller="theme">
    <div class="grid min-h-screen lg:grid-cols-2">
      <aside class="relative hidden flex-col justify-between overflow-hidden bg-gradient-to-br from-indigo-600 via-violet-600 to-fuchsia-600 p-12 text-white lg:flex">
        <div class="pointer-events-none absolute -top-24 -right-24 size-96 rounded-full bg-white/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 -left-16 size-96 rounded-full bg-fuchsia-300/20 blur-3xl"></div>

        <a href="/" class="relative flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-white/20 ring-1 ring-white/30 backdrop-blur">
            <%= icon :check, classes: "size-6", stroke: 2.5 %>
          </span>
          <span class="text-2xl font-extrabold tracking-tight">Listo</span>
        </a>

        <div class="relative">
          <h2 class="text-4xl leading-tight font-extrabold tracking-tight">Tus tareas,<br>por fin en orden.</h2>
          <p class="mt-4 max-w-md text-lg text-indigo-100">Organiza tu casa, tu trabajo y tus viajes en listas claras. Sin ruido, sin distracciones.</p>

          <div class="mt-10 max-w-sm space-y-3" aria-hidden="true">
            <% [
              [ "Reservar el vuelo a Manila", "✈️", true ],
              [ "Montar las estanterías nuevas", "📦", false ],
              [ "Preparar la demo del lunes", "💼", false ]
            ].each_with_index do |(title, emoji, done), index| %>
              <div class="flex items-center gap-3 rounded-2xl bg-white/15 px-4 py-3 shadow-lg ring-1 ring-white/20 backdrop-blur <%= "translate-x-6" if index == 1 %>">
                <span class="grid size-5 shrink-0 place-items-center rounded-full border-2 <%= done ? "border-white bg-white text-indigo-600" : "border-white/60" %>">
                  <%= icon :check, classes: "size-3", stroke: 3.5 if done %>
                </span>
                <span class="flex-1 text-sm font-medium <%= "line-through opacity-70" if done %>"><%= title %></span>
                <span><%= emoji %></span>
              </div>
            <% end %>
          </div>
        </div>

        <p class="relative text-sm text-indigo-200">Gratis · Sin anuncios · Modo claro y oscuro</p>
      </aside>

      <main class="relative flex items-center justify-center px-6 py-12">
        <button type="button" class="icon-btn absolute top-5 right-5" data-action="theme#toggle" aria-label="Cambiar tema">
          <%= icon :moon, classes: "size-5 dark:hidden" %>
          <%= icon :sun, classes: "hidden size-5 dark:block" %>
        </button>

        <div class="w-full max-w-sm">
          <a href="/" class="mb-10 flex items-center gap-3 lg:hidden">
            <%= render "shared/logo" %>
            <span class="text-2xl font-extrabold tracking-tight">Listo</span>
          </a>

          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
