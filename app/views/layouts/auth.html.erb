<!DOCTYPE html>
<html lang="es" class="h-full">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="min-h-full bg-gradient-to-br from-indigo-50 via-white to-violet-50 font-sans text-slate-900 antialiased dark:from-slate-950 dark:via-slate-950 dark:to-indigo-950/40 dark:text-slate-100"
        data-controller="theme">
    <div class="flex min-h-screen flex-col items-center justify-center px-4 py-12">
      <a href="/" class="mb-8 flex items-center gap-3">
        <%= render "shared/logo" %>
        <span class="text-2xl font-extrabold tracking-tight">Listo</span>
      </a>

      <div class="card w-full max-w-sm p-7">
        <%= yield %>
      </div>

      <p class="mt-8 text-xs text-slate-400">Tus tareas, en orden.</p>
    </div>

    <%= render "shared/flash" %>
  </body>
</html>
