<% content_for :title, "Crear cuenta" %>

<h1 class="text-xl font-bold tracking-tight">Crea tu cuenta</h1>
<p class="mt-1 text-sm text-slate-500">Es gratis y solo te llevará un minuto.</p>

<%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
  <% if @user.errors.any? %>
    <ul class="space-y-1 rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:bg-rose-500/15 dark:text-rose-300" role="alert">
      <% @user.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :name, "Nombre", class: "label" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", placeholder: "Tu nombre", class: "input" %>
  </div>

  <div>
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autocomplete: "email", placeholder: "tu@email.com", class: "input" %>
  </div>

  <div>
    <%= form.label :password, "Contraseña", class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72,
          placeholder: "Mínimo 8 caracteres", class: "input" %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Repite la contraseña", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>

  <%= form.submit "Crear cuenta", class: "btn-primary w-full" %>
<% end %>

<p class="mt-6 text-center text-sm text-slate-500">
  ¿Ya tienes cuenta?
  <%= link_to "Inicia sesión", new_session_path, class: "font-semibold text-indigo-600 hover:underline dark:text-indigo-400" %>
</p>
